# Cadena de conexión PostgreSQL (p.ej. Neon, Supabase, Railway)
DATABASE_URL="postgresql://usuario:password@host:5432/basededatos?sslmode=require"

# Secreto para firmar los tokens JWT
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Puerto del servidor (Render/Railway lo inyectan automáticamente)
PORT=4000
