# Copiar a .env y ajustar antes de "docker compose up -d"

# --- Base de datos PostgreSQL ---
POSTGRES_USER=canasta
POSTGRES_PASSWORD=canasta
POSTGRES_DB=canasta

# --- Backend ---
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# --- Frontend ---
# URL pública del backend que verá el NAVEGADOR (se hornea al construir).
# En local: http://localhost:8011/api
# En un server: http://IP_O_DOMINIO_DEL_SERVER:8011/api
VITE_API_URL=http://localhost:8011/api
